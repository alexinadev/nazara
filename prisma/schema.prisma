//   userId    String
//   userRole  Role
//   token     String
//   createdAt DateTime @default(now())

//   @@index([userId])
//   @@index([token])
// }
model DeviceToken {
  id         String   @id @default(uuid())
  token      String
  staffId    String?  
  customerId String?

  staff      Staff?    @relation("StaffDeviceTokens", fields: [staffId], references: [id])
  customer   Customer? @relation("CustomerDeviceTokens", fields: [customerId], references: [id])

  createdAt  DateTime @default(now())
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
