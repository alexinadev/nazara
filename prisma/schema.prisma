model Review {
  id             String              @id @default(uuid())
  appointmentId  String              @unique
  appointment    Appointment         @relation(fields: [appointmentId], references: [id])
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id])
  comment        String?
  createdAt      DateTime            @default(now())

  criteriaScores ReviewCriteriaScore[]
}

model ReviewCriteria {
  id        String   @id @default(cuid())
  name      String
  weight    Float    @default(1)
  createdAt DateTime @default(now())
  criteriaScores ReviewCriteriaScore[]
}

model ReviewCriteriaScore {
  id         String  @id @default(cuid())
  reviewId   String
  criteriaId String
  score      Int     // 1-5

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criteria   ReviewCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        String   @id @default(uuid())
  salonId   String?
  staffId   String?
  url       String
  createdAt DateTime @default(now())

  salon     Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff     Staff?  @relation(fields: [staffId], references: [id])

  @@index([salonId])
  @@index([staffId])
}

model Discount {
  id          String   @id @default(cuid())
  salonId     String?
  code        String   @unique
  description String?
  percentage  Float?
  amount      Float?
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())

  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentDiscounts AppointmentDiscount[]
}

model AppointmentDiscount {
  id            String   @id @default(cuid())
  appointmentId String
  discountId    String
  appliedAmount Float
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  discount      Discount    @relation(fields: [discountId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  userRole   Role
  title      String
  body       String
  meta       Json?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model StaffSpecialty {
  id        String  @id @default(cuid())
  staffId   String
  name      String
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  amount        Float
  method        String
  status        PaymentStatus @default(PENDING)
  providerData  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model FavoriteSalon {
  id        String   @id @default(cuid())
  salonId   String
  customerId String
  createdAt DateTime @default(now())

  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([salonId, customerId])
}

model FavoriteStaff {
  id         String   @id @default(cuid())
  staffId    String
  customerId String
  createdAt  DateTime @default(now())

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([staffId, customerId])
}

model SearchHistory {
  id         String   @id @default(cuid())
  customerId String
  query      String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

