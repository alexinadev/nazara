generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Salon {
  id          String    @id @default(uuid())
  name        String
  description String?
  phone       String
  address     String
  lat         Float?
  lng         Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staff       Staff[]
  categories  Category[]
  gallery     Gallery[]
  discounts   Discount[]
  favorites   FavoriteSalon[]
  appointments Appointment[]
}

model Staff {
  id             String    @id @default(uuid())
  salonId        String
  firstName      String
  lastName       String
  phone          String  @unique
  role           Role    @default(STAFF)
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  workingHours   StaffWorkingHours[]
  dayOffs        StaffDayOff[]
  services       StaffService[]
  specialties    StaffSpecialty[]
  appointments   Appointment[]
  favorites      FavoriteStaff[]
  deviceTokens   DeviceToken[]  @relation("StaffDeviceTokens")
  galleries      Gallery[]
}

model StaffWorkingHours {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int    // 0=Sunday .. 6=Saturday
  startTime String // "09:00"
  endTime   String // "17:00"
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffDayOff {
  id        String   @id @default(cuid())
  staffId   String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Category {
  id        String     @id @default(cuid())
  salonId   String?
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  salon     Salon?     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services   Service[]
}

model Service {
  id             String   @id @default(cuid())
  subCategoryId  String?
  name           String
  description    String?
  baseDuration   Int      // minutes
  basePrice      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subCategory    SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  options        ServiceOption[]
  staffServices  StaffService[]
}

model ServiceOption {
  id         String   @id @default(cuid())
  serviceId  String
  name       String
  extraPrice Float
  duration   Int      // extra minutes
  createdAt  DateTime @default(now())

  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  serviceId String
  price     Float?
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([serviceId])
}

model Customer {
  id            String    @id @default(uuid())
  phone         String    @unique
  firstName     String?
  lastName      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[]
  reviews       Review[]
  favoritesSalon FavoriteSalon[]
  favoritesStaff FavoriteStaff[]
  searchHistory SearchHistory[]
  deviceTokens  DeviceToken[]  @relation("CustomerDeviceTokens")
}

model Appointment {
  id             String   @id @default(uuid())
  salonId        String
  staffId        String
  customerId     String
  scheduledAt    DateTime
  duration       Int      // minutes
  totalPrice     Float
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salon          Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  logs           AppointmentLog[]
  discounts      AppointmentDiscount[]
  payment        Payment?
  review         Review?
}

model AppointmentLog {
  id            String    @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  note          String?
  createdAt     DateTime  @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

