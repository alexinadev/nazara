// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

/////////////////////
// Enums
/////////////////////

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/////////////////////
// Models
/////////////////////

model Salon {
  id          String    @id @default(cuid())
  name        String
  description String?
  phone       String
  slug        String    @unique
  address     String
  lat         Float?
  lng         Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  staff        Staff[]
  categories   Category[]
  gallery      Gallery[]
  discounts    Discount[]
  favorites    FavoriteSalon[]
  appointments Appointment[]    // one-to-many
}

model Staff {
  id             String    @id @default(cuid())
  salonId        String
  firstName      String
  lastName       String
  phone          String    @unique
  role           Role      @default(STAFF)
  bio            String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  salon          Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  workingHours   StaffWorkingHours[]
  dayOffs        StaffDayOff[]
  services       StaffService[]
  specialties    StaffSpecialty[]
  appointments   Appointment[]
  favorites      FavoriteStaff[]
  galleries      Gallery[]                // opposite relation for Gallery.staff
  deviceTokens   DeviceToken[] @relation("StaffDeviceTokens")

  @@index([salonId])
}

model StaffWorkingHours {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int      // 0 = Sunday .. 6 = Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  createdAt DateTime @default(now())

  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffDayOff {
  id        String   @id @default(cuid())
  staffId   String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Category {
  id        String     @id @default(cuid())
  salonId   String?
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  salon     Salon?     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services   Service[]
}

model Service {
  id             String   @id @default(cuid())
  subCategoryId  String?
  name           String
  description    String?
  baseDuration   Int      // minutes
  basePrice      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subCategory    SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  options        ServiceOption[]
  staffServices  StaffService[]
  // appointments referenced directly from Appointment (no AppointmentItem)
}

model ServiceOption {
  id         String   @id @default(cuid())
  serviceId  String
  name       String
  extraPrice Float
  duration   Int      // extra minutes
  createdAt  DateTime @default(now())

  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  serviceId String
  price     Float?
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([serviceId])
}

model Customer {
  id            String    @id @default(cuid())
  phone         String    @unique
  firstName     String?
  lastName      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[]
  reviews       Review[]
  favoritesSalon FavoriteSalon[]
  favoritesStaff FavoriteStaff[]
  searchHistory SearchHistory[]
  deviceTokens  DeviceToken[] @relation("CustomerDeviceTokens")

  @@index([phone])
}

model Appointment {
  id             String   @id @default(cuid())
  salonId        String
  staffId        String
  customerId     String
  scheduledAt    DateTime
  duration       Int      // minutes
  totalPrice     Float
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  logs           AppointmentLog[]
  discounts      AppointmentDiscount[]
  payment        Payment?
  review         Review?  // one-to-one optional

  @@index([salonId])
  @@index([staffId])
  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
}

model AppointmentLog {
  id            String    @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  note          String?
  createdAt     DateTime  @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  customerId    String
  rating        Float
  comment       String?
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  criteriaScores ReviewCriteriaScore[]

  @@index([customerId])
}

model ReviewCriteria {
  id        String   @id @default(cuid())
  name      String   @unique
  weight    Float    @default(1)
  createdAt DateTime @default(now())
  criteriaScores ReviewCriteriaScore[]
}

model ReviewCriteriaScore {
  id         String  @id @default(cuid())
  reviewId   String
  criteriaId String
  score      Int     // 1-5

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criteria   ReviewCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([criteriaId])
}

model Gallery {
  id        String   @id @default(cuid())
  salonId   String?
  staffId   String?
  url       String
  createdAt DateTime @default(now())

  salon     Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  @@index([salonId])
  @@index([staffId])
}

model Discount {
  id          String   @id @default(cuid())
  salonId     String?
  code        String   @unique
  description String?
  percentage  Float?
  amount      Float?
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())

  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentDiscounts AppointmentDiscount[]

  @@index([code])
}

model AppointmentDiscount {
  id            String   @id @default(cuid())
  appointmentId String
  discountId    String
  appliedAmount Float
  createdAt     DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  discount      Discount    @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([discountId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  userRole   Role
  title      String
  body       String
  meta       Json?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model StaffSpecialty {
  id        String  @id @default(cuid())
  staffId   String
  name      String
  createdAt DateTime @default(now())

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String  @id @default(cuid())
  appointmentId String  @unique
  amount        Float
  method        String
  status        PaymentStatus @default(PENDING)
  providerData  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model FavoriteSalon {
  id         String   @id @default(cuid())
  salonId    String
  customerId String
  createdAt  DateTime @default(now())

  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([salonId, customerId])
  @@index([customerId])
}

model FavoriteStaff {
  id         String   @id @default(cuid())
  staffId    String
  customerId String
  createdAt  DateTime @default(now())

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([staffId, customerId])
  @@index([customerId])
}

model SearchHistory {
  id         String   @id @default(cuid())
  customerId String
  query      String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  token      String
  // optional links to both Staff and Customer (allows storing refresh tokens or push tokens)
  staffId    String? 
  customerId String?
  userRole   Role?
  createdAt  DateTime @default(now())

  staff      Staff?    @relation("StaffDeviceTokens", fields: [staffId], references: [id], onDelete: Cascade)
  customer   Customer? @relation("CustomerDeviceTokens", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([customerId])
  @@index([token])
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
